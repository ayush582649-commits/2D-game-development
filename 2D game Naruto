
import pygame

pygame.init()

screen = pygame.display.set_mode((500, 500))
pygame.display.set_caption("Naruto 2D Game")

# Load background image (make sure 'background.png' is in the same folder)
background = pygame.image.load("background.png")
background = pygame.transform.scale(background, (500, 500))  # Resize to fit window

WHITE = (255, 255, 255)
RED = (255, 0, 0)

x = 200
y = 200
width = 50
height = 50
speed = 5

running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    keys = pygame.key.get_pressed()
    if keys[pygame.K_LEFT]:
        x -= speed
    if keys[pygame.K_RIGHT]:
        x += speed
    if keys[pygame.K_UP]:
        y -= speed
    if keys[pygame.K_DOWN]:
        y += speed

    # Draw background
    screen.blit(background, (0, 0))

    # Draw player (rectangle for now)
    pygame.draw.rect(screen, RED, (x, y, width, height))

    pygame.display.update()

pygame.quit()
